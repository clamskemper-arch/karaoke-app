# --- Node / Nuxt (frontend) ---
node_modules/
frontend/.nuxt/
frontend/.output/
frontend/.nitro/
frontend/.data/
frontend/dist/

# --- Java / Maven (backend) ---
backend/target/
# H2-Datei-DB (Laufzeitdaten)
backend/data/

# --- Python (konverter) ---
konverter/venv/
**/__pycache__/
*.pyc

# --- Laufzeit-Song-Speicher (vom Backend verwaltet, hochgeladene Artefakte) ---
/data/

# --- Lokaler 24/7-Deploy (Jar-Kopie + Logs, siehe scripts/install-backend-service.ps1) ---
/deploy/

# --- Konverter Ein-/Ausgabe ---
# input/ enthaelt teils urheberrechtlich geschuetztes Quellmaterial und grosse
# Mediendateien; output/ ist alles generierbar. Nur die gemeinfreie Test-MIDI
# bleibt als Fixture drin (siehe convert_midi.py-Docstring).
konverter/input/*
!konverter/input/amazing-grace.kar
konverter/output/

# --- Logs ---
*.log

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
